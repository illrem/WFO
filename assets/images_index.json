---
permalink: /assets/images_index.json
---
[
{% assign files = site.static_files | where_exp: "f", "f.path contains '/images/'" %}
{% for f in files %}
  {% assign filename = f.path | split: '/' | last %}
  {% assign parts = filename | split: '-' %}
  {% assign year = parts[0] | default: "" %}
  {% assign month = parts[1] | default: "" %}
  {% assign day_and_rest = parts[2] | default: "" %}
  {% assign day = day_and_rest | split: '.' | first | default: "" %}
  {
    "path": "{{ f.path }}",
    "filename": "{{ filename }}",
    "year": "{{ year }}",
    "month": "{{ month }}",
    "day": "{{ day }}"
  }{% if forloop.last == false %},{% endif %}
{% endfor %}
]
